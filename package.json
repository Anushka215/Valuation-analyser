{
  "name": "valuation-analyser",
  "version": "0.1.0",
  "private": true,
  "description": "Property Valuation Compliance Checker",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "worker": "tsx watch src/queue/runWorker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "validate:rules": "tsx scripts/validate-rules.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bullmq": "^6.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "ioredis": "^6.0.0",
    "multer": "^2.2.0",
    "pdf2pic": "^3.2.0",
    "pino": "^9.3.2",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.0",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^11.2.2",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
