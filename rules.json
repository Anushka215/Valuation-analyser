      {
        "id": "LUDHIANA_MIN_OWNERSHIP_YEARS",
        "description": "Commercial, industrial, or residential property in Ludhiana must have at least 13 years of ownership.",
        "severity": "MEDIUM",
        "effective_from": "2026-07-31",
        "field": "ownership_years",
