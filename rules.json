        "check": "ratio_in_range",
        "params": { "denominatorField": "land_area_sqft", "min": 20 },
        "clause_ref": "C.3 / Annexure I.E.7"
      },
      {
        "id": "BUILDING_VALUE_NO_SANCTIONED_PLAN_AGE_GATE",
        "description": "Property must be more than 5 years old to use building valuation in the absence of a sanctioned plan.",
        "severity": "MEDIUM",
        "effective_from": "2026-07-31",
        "field": "property_age_years",
        "check": "in_range",
        "params": { "min": 5, "minExclusive": true },
        "clause_ref": "H.9"
      },
      {
