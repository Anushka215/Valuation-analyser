        "severity": "MEDIUM",
        "effective_from": "2026-07-31",
        "field": "is_leased",
        "applies_when": { "field": "property_sub_type", "in": ["industrial_land"] },
        "check": "not_equals",
        "params": { "value": true },
        "clause_ref": "F.9"
      },
      {
        "id": "CATEGORY_A_COMMERCIAL_SHOP_COUNT",
        "description": "Needs one-level-higher NFA: commercial property with more than 3 rented or leased shops.",
