        "severity": "MEDIUM",
        "effective_from": "2026-07-31",
        "field": "residual_lease_years",
        "applies_when": { "field": "property_sub_type", "in": ["mandi"] },
        "check": "in_range",
        "params": { "min": 10 },
        "clause_ref": "Annexure I.C"
      },
      {
        "id": "PANCHAYAT_HOUSE_MIN_ROAD_WIDTH",
