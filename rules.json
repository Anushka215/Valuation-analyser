        "params": { "value": false },
        "clause_ref": "F.17"
      },
      {
        "id": "CATEGORY_A_AMALGAMATED_NON_OVERLAPPING",
        "description": "Needs one-level-higher NFA: amalgamated property (part collateral) where the structure overlaps.",
        "severity": "MEDIUM",
        "effective_from": "2026-07-31",
        "field": "is_amalgamated_overlapping",
        "check": "not_equals",
        "params": { "value": true },
        "clause_ref": "F.18"
      },
      {
        "id": "CATEGORY_A_GODOWN",
        "description": "Needs one-level-higher NFA: godown.",
        "severity": "MEDIUM",
        "effective_from": "2026-07-31",
        "field": "property_sub_type",
        "check": "in_blocklist",
        "params": { "blocklist": ["godown"] },
        "clause_ref": "F.19"
      },
      {
        "id": "CONSTRUCTION_COMPLETION_GATE",
        "description": "Construction must be at least 85% complete to be approved by the sanctioning authority.",
        "severity": "MEDIUM",
        "effective_from": "2026-07-31",
        "field": "construction_pct",
        "check": "in_range",
        "params": { "min": 85 },
        "clause_ref": "F.2"
      },
