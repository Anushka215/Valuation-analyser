        "severity": "MEDIUM",
        "effective_from": "2026-07-31",
        "field": "approach_road_width_feet",
        "applies_when": { "field": "residential_building_type", "in": ["independent_house_upto_g2"] },
        "check": "in_range",
        "params": { "min": 10 },
        "clause_ref": "Annexure I.E.1"
      },
      {
        "id": "PANCHAYAT_APARTMENT_MIN_ROAD_WIDTH",
        "description": "Apartment: approach road must be at least 20 feet wide (interpreted as a minimum, consistent with the independent-house clause).",
        "severity": "MEDIUM",
        "effective_from": "2026-07-31",
        "field": "approach_road_width_feet",
        "applies_when": { "field": "residential_building_type", "in": ["apartment"] },
        "check": "in_range",
        "params": { "min": 20 },
        "clause_ref": "Annexure I.E.2"
      },
      {
