        "severity": "MEDIUM",
        "effective_from": "2026-07-31",
        "field": "property_sub_type",
        "check": "in_blocklist_grouped",
        "params": {
          "blocklist": [
            { "value": "industrial_land", "clause_ref": "F.4" },
            { "value": "guest_house", "clause_ref": "F.5" },
            { "value": "cinema_hall", "clause_ref": "F.6" },
            { "value": "petrol_pump", "clause_ref": "F.7" },
            { "value": "cold_storage", "clause_ref": "F.10" },
            { "value": "hostel", "clause_ref": "F.11" },
            { "value": "mall_office_shop", "clause_ref": "F.12" },
            { "value": "it_park_sez", "clause_ref": "F.13" }
          ]
        },
        "clause_ref": "F.4, F.5, F.6, F.7, F.10, F.11, F.12, F.13"
      },
      {
        "id": "CATEGORY_A_VACANT_INDUSTRIAL",
        "description": "Needs one-level-higher NFA: vacant industrial property.",
        "severity": "MEDIUM",
        "effective_from": "2026-07-31",
        "field": "is_vacant",
        "applies_when": { "field": "property_sub_type", "in": ["industrial_land"] },
        "check": "not_equals",
        "params": { "value": true },
        "clause_ref": "F.8"
      },
