        "applies_when": { "field": "property_type", "in": ["residential"] },
        "check": "in_range",
        "params": { "max": 3 },
        "clause_ref": "F.15"
      },
      {
        "id": "CATEGORY_A_UNDIVIDED_SHARE_NO_DEMARCATION",
