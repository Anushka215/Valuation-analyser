        "check": "in_range",
        "params": { "min": 13 },
        "clause_ref": "Annexure I.E (Ludhiana)"
      },
      {
        "id": "CARPET_AREA_MEASURED_VS_DOCUMENTED",
        "description": "Measured carpet area must match the documented carpet area within tolerance; a mismatch needs human review, not an automatic fail.",
        "severity": "MEDIUM",
        "effective_from": "2026-07-31",
        "field": "carpet_area_measured",
        "check": "fields_match_within_tolerance",
        "params": {
          "compareField": "carpet_area_documented",
          "tolerance": 3,
          "mode": "percentage",
          "onMismatch": "NEEDS_REVIEW"
        },
        "clause_ref": "H.I (area verification)"
      }
