[
  {
    "version": "2026-07-31",
    "effective_from": "2026-07-31",
    "rules": [
      {
        "id": "VACANT_LAND_AREA_RANGE",
        "description": "Vacant land collateral area must be between 800 and 10,000 sqft.",
        "severity": "HIGH",
        "effective_from": "2026-07-31",
        "field": "vacant_land_area_sqft",
        "applies_when": { "field": "property_type", "in": ["vacant_land"] },
        "check": "in_range",
        "params": { "min": 800, "max": 10000 },
        "clause_ref": "B"
      },
      {
        "id": "TECHNICAL_REPORT_VALIDITY",
        "description": "Technical valuation report is valid for 180 days, measured up to the approval date.",
        "severity": "MEDIUM",
        "effective_from": "2026-07-31",
        "field": "technical_report_date",
        "check": "max_age_days",
        "params": { "maxDays": 180, "asOfField": "approval_date" },
        "clause_ref": "H.I.1"
      },
      {
        "id": "COMMERCIAL_MIN_BUA",
        "description": "Commercial property must have at least 100 sqft of built-up area (BUA).",
        "severity": "MEDIUM",
        "effective_from": "2026-07-31",
        "field": "commercial_bua_sqft",
        "applies_when": { "field": "property_type", "in": ["commercial"] },
        "check": "in_range",
        "params": { "min": 100 },
        "clause_ref": "H.I.5"
      },
      {
        "id": "CATEGORY_B_LAND_ACQUISITION_PENDING",
        "description": "Hard block: government land acquisition is initiated, pending, or announced for this property.",
        "severity": "HIGH",
        "effective_from": "2026-07-31",
        "field": "land_acquisition_pending",
        "check": "not_equals",
        "params": { "value": true },
        "clause_ref": "G.1"
      },
      {
        "id": "CATEGORY_B_OUTSIDE_INDIA",
        "description": "Hard block: property is located outside India.",
        "severity": "HIGH",
        "effective_from": "2026-07-31",
        "field": "is_outside_india",
        "check": "not_equals",
        "params": { "value": true },
        "clause_ref": "G.2"
      },
      {
        "id": "CATEGORY_B_BLOCKLIST",
        "description": "Hard block: property sub-type matches one of the blocked categories (Chawl/Gaothan/Pagdi, stone crusher, old age home/orphanage, Lal Dora, hazardous industry, reserve forest, agricultural farmland/farmhouse).",
        "severity": "HIGH",
        "effective_from": "2026-07-31",
        "field": "property_sub_type",
        "check": "in_blocklist_grouped",
        "params": {
          "blocklist": [
            { "value": "chawl_gaothan_pagdi", "clause_ref": "G.3" },
            { "value": "stone_crusher", "clause_ref": "G.4" },
            { "value": "old_age_home_orphanage", "clause_ref": "G.5" },
            { "value": "lal_dora", "clause_ref": "G.6" },
            { "value": "hazardous_industry", "clause_ref": "G.10" },
            { "value": "reserve_forest", "clause_ref": "G.13" },
            { "value": "agricultural_farmland", "clause_ref": "G.16" }
          ]
        },
        "clause_ref": "G.3, G.4, G.5, G.6, G.10, G.13, G.16"
      },
      {
        "id": "CATEGORY_B_TITLE_DEED_PENDING",
        "description": "Hard block: title deeds are pending with the registrar.",
        "severity": "HIGH",
        "effective_from": "2026-07-31",
        "field": "title_deed_pending",
        "check": "not_equals",
        "params": { "value": true },
        "clause_ref": "G.7"
      },
      {
        "id": "CATEGORY_B_RELIGIOUS_MONUMENT",
        "description": "Hard block: property has religious monuments or constructions.",
        "severity": "HIGH",
        "effective_from": "2026-07-31",
        "field": "has_religious_monument",
        "check": "not_equals",
        "params": { "value": true },
        "clause_ref": "G.8"
      },
      {
        "id": "CATEGORY_B_GRAMA_NATHAM",
        "description": "Hard block: Grama Natham property, except in Tamil Nadu.",
        "severity": "HIGH",
        "effective_from": "2026-07-31",
        "field": "property_sub_type",
        "applies_when": { "field": "state", "notIn": ["Tamil Nadu"] },
        "check": "in_blocklist",
        "params": { "blocklist": ["grama_natham"] },
        "clause_ref": "G.9"
      },
      {
        "id": "CATEGORY_B_LAND_LOCKED",
        "description": "Hard block: property is land-locked.",
        "severity": "HIGH",
        "effective_from": "2026-07-31",
        "field": "is_land_locked",
        "check": "not_equals",
        "params": { "value": true },
        "clause_ref": "G.11"
      },
      {
        "id": "CATEGORY_B_BUFFER_ZONE",
        "description": "Hard block: property is on a buffer zone.",
        "severity": "HIGH",
        "effective_from": "2026-07-31",
        "field": "is_on_buffer_zone",
        "check": "not_equals",
        "params": { "value": true },
        "clause_ref": "G.12"
      },
      {
        "id": "CATEGORY_B_BUILT_ON_AGRI_LAND",
        "description": "Hard block: industrial/commercial/residential property built on agricultural land.",
        "severity": "HIGH",
        "effective_from": "2026-07-31",
        "field": "built_on_agricultural_land",
        "check": "not_equals",
        "params": { "value": true },
        "clause_ref": "G.17"
      },
      {
        "id": "CATEGORY_B_AMALGAMATED_OVERLAPPING",
        "description": "Hard block: amalgamated property (part collateral) where the structure overlaps.",
        "severity": "HIGH",
        "effective_from": "2026-07-31",
        "field": "is_amalgamated_overlapping",
        "check": "not_equals",
        "params": { "value": true },
        "clause_ref": "G.18"
      },
      {
        "id": "CATEGORY_A_UNDER_CONSTRUCTION",
        "description": "Needs one-level-higher NFA: property is under construction (less than 85% complete).",
        "severity": "MEDIUM",
        "effective_from": "2026-07-31",
        "field": "construction_pct",
        "check": "in_range",
        "params": { "min": 85 },
        "clause_ref": "F.1"
      },
      {
        "id": "CATEGORY_A_HUF_OWNERSHIP",
        "description": "Needs one-level-higher NFA: property belongs to a Hindu Undivided Family (HUF).",
        "severity": "MEDIUM",
        "effective_from": "2026-07-31",
        "field": "ownership_type",
        "check": "in_blocklist",
        "params": { "blocklist": ["HUF"] },
        "clause_ref": "F.3"
      },
      {
        "id": "CATEGORY_A_BLOCKLIST",
